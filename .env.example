# Neon PostgreSQL connection string (get this from https://console.neon.tech)
DATABASE_URL="postgresql://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require"

# Local backend port (default: 3000)
PORT=3000

# Optional: override backend URL for the mobile app (e.g. your computer's LAN IP for Expo Go on a phone)
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
